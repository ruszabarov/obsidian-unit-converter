		"@types/node": "^25.8.0",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"builtin-modules": "5.2.0",
		"eslint": "^10.4.0",
		"globals": "^17.6.0",
		"obsidian": "latest",
		"rolldown": "1.0.1",
